# Clé API Anthropic — serveur uniquement, jamais exposée au client.
ANTHROPIC_API_KEY=

# Modèle utilisé par les quatre fonctions IA.
CLAUDE_MODEL=claude-opus-5

# Port du serveur d'API.
PORT=8787

# Mode maquette : renvoie des réponses de démonstration sans appeler l'API
# (utile pour développer l'interface sans clé). 1 = activé.
AI_MOCK=0

# --- Base de données (Supabase, projet « entre-seances », eu-west-3) ---
# L'URL et la clé publiable sont destinées au navigateur : elles ne donnent
# accès qu'à ce que la RLS autorise pour l'utilisateur connecté.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Clé de service : SERVEUR UNIQUEMENT. Elle contourne la RLS — elle ne doit
# jamais apparaître dans une variable préfixée VITE_, ni dans un dépôt.
SUPABASE_SERVICE_ROLE_KEY=
