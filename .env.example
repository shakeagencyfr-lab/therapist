# Clé API Anthropic — serveur uniquement, jamais exposée au client.
ANTHROPIC_API_KEY=

# Modèle utilisé par les cinq fonctions IA.
CLAUDE_MODEL=claude-opus-5

# Port du serveur d'API.
PORT=8787

# Mode maquette : renvoie des réponses de démonstration sans appeler l'API
# (utile pour développer l'interface sans clé). 1 = activé.
AI_MOCK=0

# --- Base de données (Supabase, projet « entre-seances », eu-west-3) ---
# L'URL et la clé publiable sont destinées au navigateur : elles ne donnent
# accès qu'à ce que la RLS autorise pour l'utilisateur connecté.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Clé de service : SERVEUR UNIQUEMENT. Elle contourne la RLS — elle ne doit
# jamais apparaître dans une variable préfixée VITE_, ni dans un dépôt.
SUPABASE_SERVICE_ROLE_KEY=

# --- Envoi des invitations (serveur uniquement) ---
# La clé de service contourne la RLS : elle ne sert qu'à envoyer le courriel
# d'invitation, jamais à lire des données. Jamais de préfixe VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Adresse publique du site, pour la destination du lien. Fixée par le serveur
# et jamais reçue du client : une URL de retour arbitraire ouvrirait une
# redirection depuis un courriel de confiance.
PUBLIC_SITE_URL=https://therapist-blond.vercel.app

# --- Intégrations des cabinets (serveur uniquement) ---
# Clé de chiffrement des secrets que les cabinets confient au serveur (clé
# Anthropic, clé Stripe). 32 octets aléatoires : `openssl rand -base64 32`.
# Sans elle, l'onglet Intégrations refuse d'enregistrer une clé plutôt que
# de la stocker en clair. À ne jamais changer une fois des clés posées.
INTEGRATIONS_KEY=

# --- Marque blanche totale (serveur uniquement) ---
# Jeton d'hébergeur, pour enregistrer le domaine d'un cabinet et le vérifier
# sans intervention. Sans lui, tout continue de fonctionner : le serveur dicte
# les enregistrements DNS à poser et vérifie par une vraie résolution.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Uniquement si le projet appartient à une équipe.
VERCEL_TEAM_ID=
# Ce que doivent viser les enregistrements posés à la main. Les valeurs par
# défaut sont celles de Vercel ; les changer suit un changement d'hébergeur.
DOMAIN_CNAME_TARGET=cname.vercel-dns.com
DOMAIN_A_TARGET=76.76.21.21

# --- Sites vitrines (serveur uniquement) ---
# Clé Google Places (New), pour importer la fiche d'un cabinet : nom, adresse,
# horaires, photos, avis. C'est la clé de la PLATEFORME, pas celle du cabinet.
# Sans elle, la page se remplit à la main et rien d'autre ne change.
GOOGLE_PLACES_KEY=
