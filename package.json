{
  "name": "entre-seances",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Suivi entre-séances pour thérapeutes — Cabinet Laetitia Ollivier",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"npm run dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b --force && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit --force && tsc -p tsconfig.server.json --noEmit",
    "start": "node --import tsx server/index.ts",
    "check:render": "tsx --tsconfig tsconfig.app.json --import ./scripts/render-register.mjs scripts/render-check.mts",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run check:render"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.0",
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "nodemailer": "^7.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^18.5.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vercel/node": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
